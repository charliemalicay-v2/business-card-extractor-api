# Copy to .env and fill in local values.

# Local PostgreSQL connection
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/business_cards

# Local llama.cpp GGUF model path
LLM_MODEL_PATH=./models/model.gguf

# Upload constraints
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/png

# OCR
OCR_MIN_TEXT_LENGTH=10

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Image storage backend: local, s3, or supabase
IMAGE_STORAGE_BACKEND=local
IMAGE_STORAGE_LOCAL_DIR=./data/images
IMAGE_STORAGE_URL_TTL_SECONDS=3600

# AWS S3 (only used when IMAGE_STORAGE_BACKEND=s3)
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Supabase Storage (only used when IMAGE_STORAGE_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_PUBLIC=false
