{
  "info": {
    "name": "Business Card Extractor API",
    "description": "REST API that extracts structured contact data (name, position, company, email, phone) from business card images, with QR-code cross-checking and a review workflow for conflicts. See docs/API_USAGE.md in the repo for full scenario walkthroughs.\n\nNo authentication required (internal/local tool).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "business-card-extractor-api"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "card_id", "value": "", "type": "string", "description": "Auto-populated by the 'Upload Business Card' request's test script." },
    { "key": "needs_review_card_id", "value": "", "type": "string", "description": "Manually set this to a card id whose status is needs_review before running the Review folder requests." }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Service liveness check.",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Returns {\"status\": \"ok\"} if the API process is up. Does not indicate whether the LLM model or database are reachable."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cards - Upload",
      "description": "POST /cards: upload a business card image and run the full extraction pipeline (validate -> OCR -> QR -> LLM -> reconcile -> persist).",
      "item": [
        {
          "name": "Upload Business Card (Happy Path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set(\"card_id\", body.id);",
                  "    pm.test(\"Response has an id\", function () {",
                  "        pm.expect(body.id).to.be.a(\"string\");",
                  "    });",
                  "    pm.test(\"Status is confirmed or needs_review\", function () {",
                  "        pm.expect([\"confirmed\", \"needs_review\"]).to.include(body.status);",
                  "    });",
                  "    if (body.status === \"needs_review\") {",
                  "        pm.collectionVariables.set(\"needs_review_card_id\", body.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "A JPEG or PNG image of a business card. Select a file before sending."
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/cards",
              "host": ["{{base_url}}"],
              "path": ["cards"]
            },
            "description": "Uploads an image and runs the full pipeline synchronously. On success (201), sets the {{card_id}} collection variable for use by the Retrieval/Review folders below.\n\nResponse status will be:\n- confirmed: all fields agreed or only one source (OCR/LLM or QR) had data\n- needs_review: at least one field conflicts between OCR/LLM and QR -> use the Review folder to resolve it"
          },
          "response": []
        },
        {
          "name": "Upload - Unsupported Content Type (Error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"error_code is unsupported_format\", function () {",
                  "    pm.expect(pm.response.json().error_code).to.eql(\"unsupported_format\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select any non-image file (e.g. a .txt or .pdf) to trigger this error."
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/cards",
              "host": ["{{base_url}}"],
              "path": ["cards"]
            },
            "description": "Demonstrates the 400 unsupported_format error: the uploaded file's content-type isn't image/jpeg or image/png."
          },
          "response": []
        },
        {
          "name": "Upload - Non-Business-Card Image (Error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 422\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test(\"error_code is not_a_business_card\", function () {",
                  "    pm.expect(pm.response.json().error_code).to.eql(\"not_a_business_card\");",
                  "});",
                  "pm.test(\"response includes a failure stage\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"stage\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select an image that is clearly not a business card (e.g. a landscape photo) to trigger this error."
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/cards",
              "host": ["{{base_url}}"],
              "path": ["cards"]
            },
            "description": "Demonstrates the 422 not_a_business_card error, raised when the image fails the shape or text-pattern classification stage. The response includes a \"stage\" field (\"shape\" or \"text_pattern\") indicating where validation failed."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cards - Retrieval",
      "description": "GET /cards/{id} and GET /cards: fetch a single record or list/filter/paginate records.",
      "item": [
        {
          "name": "Get Card by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response includes raw_ocr_text (full detail view)\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"raw_ocr_text\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/cards/{{card_id}}",
              "host": ["{{base_url}}"],
              "path": ["cards", "{{card_id}}"]
            },
            "description": "Returns the full record, including raw_ocr_text. Run 'Upload Business Card (Happy Path)' first to populate {{card_id}}."
          },
          "response": []
        },
        {
          "name": "Get Card - Not Found (Error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"error_code is record_not_found\", function () {",
                  "    pm.expect(pm.response.json().error_code).to.eql(\"record_not_found\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/cards/00000000-0000-0000-0000-000000000000",
              "host": ["{{base_url}}"],
              "path": ["cards", "00000000-0000-0000-0000-000000000000"]
            },
            "description": "Demonstrates the 404 record_not_found error for a non-existent id."
          },
          "response": []
        },
        {
          "name": "List Cards",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has items/total/page/page_size\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.all.keys(\"items\", \"total\", \"page\", \"page_size\");",
                  "});",
                  "pm.test(\"List items omit raw_ocr_text\", function () {",
                  "    const body = pm.response.json();",
                  "    if (body.items.length > 0) {",
                  "        pm.expect(body.items[0]).to.not.have.property(\"raw_ocr_text\");",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/cards?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["cards"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" }
              ]
            },
            "description": "Lists all records, paginated. List items omit raw_ocr_text for a lighter payload; use Get Card by ID for the full record."
          },
          "response": []
        },
        {
          "name": "List Cards - Filter by Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"All returned items have the requested status\", function () {",
                  "    const body = pm.response.json();",
                  "    body.items.forEach((item) => pm.expect(item.status).to.eql(\"needs_review\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/cards?status=needs_review&page=1&page_size=10",
              "host": ["{{base_url}}"],
              "path": ["cards"],
              "query": [
                { "key": "status", "value": "needs_review" },
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "10" }
              ]
            },
            "description": "Lists only records pending review (status=needs_review), most useful for building an operator review queue."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cards - Review",
      "description": "PATCH /cards/{id}/review: resolve a record whose status is needs_review by supplying final values for the conflicting field(s).",
      "item": [
        {
          "name": "Resolve Review Conflict",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 or 400\", function () {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Record status is now confirmed\", function () {",
                  "        pm.expect(pm.response.json().status).to.eql(\"confirmed\");",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"Acme Corporation\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/cards/{{needs_review_card_id}}/review",
              "host": ["{{base_url}}"],
              "path": ["cards", "{{needs_review_card_id}}", "review"]
            },
            "description": "Set {{needs_review_card_id}} to a record whose status is needs_review (see List Cards - Filter by Status), then supply the operator's final decision for the conflicting field(s) as a JSON body. Only include fields you're resolving -- unresolved fields are left untouched. Returns 400 invalid_review_payload if the record isn't pending review or the payload is empty."
          },
          "response": []
        },
        {
          "name": "Resolve Review - Empty Payload (Error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"error_code is invalid_review_payload\", function () {",
                  "    pm.expect(pm.response.json().error_code).to.eql(\"invalid_review_payload\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/cards/{{needs_review_card_id}}/review",
              "host": ["{{base_url}}"],
              "path": ["cards", "{{needs_review_card_id}}", "review"]
            },
            "description": "Demonstrates the 400 invalid_review_payload error when no field values are provided to resolve."
          },
          "response": []
        },
        {
          "name": "Resolve Review - Record Not Pending Review (Error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"error_code is invalid_review_payload\", function () {",
                  "    pm.expect(pm.response.json().error_code).to.eql(\"invalid_review_payload\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Someone Else\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/cards/{{card_id}}/review",
              "host": ["{{base_url}}"],
              "path": ["cards", "{{card_id}}", "review"]
            },
            "description": "Uses {{card_id}} (from the happy-path upload, likely already 'confirmed') to demonstrate the 400 invalid_review_payload error when attempting to resolve a record that isn't pending review."
          },
          "response": []
        }
      ]
    }
  ]
}
